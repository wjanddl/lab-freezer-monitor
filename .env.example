# 복사해서 .env로 사용 (.env는 커밋 금지)
TZ=Asia/Seoul

# InfluxDB (compose 내부 주소)
INFLUX_URL=http://influxdb:8086
INFLUX_ORG=lab
INFLUX_BUCKET=freezer
INFLUX_ADMIN_USER=admin
INFLUX_ADMIN_PASSWORD=change-me-long-password
INFLUX_TOKEN=change-me-long-random-token

# SQLite (컨테이너 내부 경로, ./data/sqlite가 마운트됨)
SQLITE_PATH=/data/sqlite/app.db

# 인증: 32자 이상 랜덤값 (생성: python -c "import secrets;print(secrets.token_urlsafe(48))")
JWT_SECRET=
# ACCESS_TTL_S=3600
# REFRESH_TTL_S=1209600
# LOGIN_MAX_FAILS=5
# LOGIN_LOCK_S=900

# 알림 (텔레그램). DASHBOARD_URL은 알림 끝에 붙일 대시보드 주소 (비우면 생략)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DASHBOARD_URL=
# TELEGRAM_TIMEOUT_S=10
# TELEGRAM_RETRIES=2
# TELEGRAM_RETRY_DELAY_S=2

# 서버 생존신호: healthchecks.io ping URL (60초마다 ping, 이상 시 /fail). 비우면 안 보냄
# 권장 체크 설정: Period 1분, Grace 5분, 알림은 텔레그램 단체방 또는 이메일
HEALTHCHECK_URL=

# 프론트(대시보드) 주소, 쉼표 구분. 다른 주소에서 띄울 때만 (예: http://localhost:5173)
CORS_ORIGINS=
