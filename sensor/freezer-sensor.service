# 사용자(kobot) systemd 유닛: ~/.config/systemd/user/에 두고 `loginctl enable-linger kobot`(1회, sudo)이면 부팅 시 자동 시작.
# sudo 없이 관리: systemctl --user restart freezer-sensor / journalctl --user -u freezer-sensor
[Unit]
Description=Freezer 센서 리더 (MAX31865 SPI → 서버)

[Service]
WorkingDirectory=%h/freezer-monitor/sensor
ExecStart=/usr/bin/python3 -u reader.py %h/freezer-monitor/sensor/config.json
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
